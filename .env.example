# ==============================================================================
# NER LOGISTICS INTELLIGENCE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=True

# Server Bind Settings
HOST=127.0.0.1
PORT=8000

# Security & Authentication
# Generate in production using: openssl rand -hex 32
JWT_SECRET_KEY=ner_secret_jwt_key_sih_hackathon_demo_2026_gov_in
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local MVP SQLite database:
DATABASE_URL=sqlite:///./ner_logistics.db

# Production Cloud PostgreSQL + PostGIS example:
# DATABASE_URL=postgresql://ner_admin:YourSecurePassword@db.internal.nerlogistics.gov.in:5432/ner_logistics

# CORS Allowed Origins (Comma-separated for multiple domains)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Uploads Configuration
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp

# External Weather API (Optional - System works with realistic fallback simulation if omitted)
# OPENWEATHER_API_KEY=your_openweather_api_key_here
ENABLE_SIMULATED_WEATHER_FALLBACK=True

# Real-Time Telemetry Simulation
ENABLE_VEHICLE_SIMULATION=True
SIMULATION_INTERVAL_SECONDS=12
