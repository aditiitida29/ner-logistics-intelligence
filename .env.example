# ==============================================================================
# NER Logistics Intelligence Platform - Environment Configuration Example
# AI-Powered Accessibility, Logistics & Emergency Response Platform
# ==============================================================================

# Application Runtime
ENVIRONMENT=development # development | staging | production
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Security & Authentication
# Generate a strong random secret key for production
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080 # 7 days

# Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite:///./ner_logistics.db

# Production PostgreSQL + PostGIS example:
# DATABASE_URL=postgresql://your_username:your_password@localhost:5432/ner_logistics_db

# Frontend Application URL (Vite)
VITE_API_URL=http://localhost:8000/api

# Cloud Object Storage (for Field Incident Photos)
STORAGE_PROVIDER=local # local | aws_s3 | gcs | azure_blob
UPLOAD_DIR=uploads/incidents

# Cloud storage examples:
# S3_BUCKET_NAME=your-bucket-name
# S3_REGION=your-region
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# ==============================================================================
# Initial Role Accounts
# ==============================================================================
# Configure account credentials securely through your deployment environment.
# Do not store real passwords or secret credentials in this file.
#
# Roles:
# 1. Super Admin
# 2. State Admin
# 3. Field Officer
# 4. Logistics Operator
# 5. Driver
