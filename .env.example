# ==============================================================================
# NER Logistics Intelligence Platform - Environment Configuration Example
# AI-Powered Accessibility, Logistics & Emergency Response Platform
# ==============================================================================

# Application Runtime
ENVIRONMENT=development # development | staging | production
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Security & Authentication (Generate random 32-byte hex for production)
SECRET_KEY=ner-logistics-secret-key-sih-2026-hackathon-super-secure-change-in-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080 # 7 days

# Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite:///./ner_logistics.db
# Production PostgreSQL + PostGIS:
# DATABASE_URL=postgresql://ner_admin:Password123@localhost:5432/ner_logistics_db

# Frontend Application URL (Vite)
VITE_API_URL=http://localhost:8000/api

# Cloud Object Storage (for Field Incident Photos)
STORAGE_PROVIDER=local # local | aws_s3 | gcs | azure_blob
UPLOAD_DIR=uploads/incidents
# S3_BUCKET_NAME=ner-logistics-media
# S3_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Seed Initial Role Accounts (Password: admin123)
# 1. Super Admin: admin@nerlogistics.gov.in
# 2. State Admin: state@nerlogistics.gov.in
# 3. Field Officer: field@nerlogistics.gov.in
# 4. Logistics Operator: logistics@nerlogistics.gov.in
# 5. Driver: driver@nerlogistics.gov.in
